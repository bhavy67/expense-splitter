# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/expense_splitter

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
# Set APP_ENV=production when deploying behind HTTPS with the frontend on a
# different origin (e.g. Vercel) — this makes the refresh cookie Secure +
# SameSite=None so the browser will send it cross-site.
APP_ENV=development
# Comma-separated list of exact origins allowed to call the API with
# credentials (no wildcards). Include your deployed frontend's URL, e.g.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
