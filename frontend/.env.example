# Supabase project — Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth (Google Identity Services client ID) — must also be added
# under Supabase Auth → Providers → Google → "Authorized Client IDs" so
# supabase.auth.signInWithIdToken() accepts tokens minted for it.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
