# Google OAuth — must match GOOGLE_CLIENT_ID in backend
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend origin (scheme + host, no trailing slash, no /api suffix).
# Leave unset for local dev (uses the Vite proxy) or same-origin hosting.
# Required when the frontend (e.g. Vercel) and backend are on different
# domains — set this to your deployed backend's URL.
# VITE_API_URL=https://your-backend-url.com

# WebSocket origin. Defaults to VITE_API_URL with http(s) swapped for
# ws(s), so you usually only need to set VITE_API_URL. Set this only if
# the WS endpoint lives on a different host than the REST API.
# VITE_WS_URL=wss://your-backend-url.com
